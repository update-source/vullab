{
  "name": "vullab",
  "version": "1.0.0",
  "description": "Vulnerable Authentication API for Learning",
  "main": "index.js",
  "scripts": {
    "start": "node src/app.js",
    "predev": "node scripts/sync-database.js",
    "dev": "nodemon app.js",
    "build:css": "node ./build-css.js",
    "db:redis": "docker compose up -d redis",
    "db:redis:down": "docker compose down",
    "db:redis:logs": "docker compose logs -f redis",
    "db:sync": "node scripts/sync-database.js --force",
    "db:sync:safe": "node scripts/sync-database.js --alter",
    "db:sync:create": "node scripts/sync-database.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "keywords": [],
  "author": "Don",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-useragent": "^2.1.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jwk-to-pem": "^2.0.7",
    "nodemailer": "^8.0.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "pug": "^3.0.3",
    "redis": "^4.7.1",
    "sequelize": "^6.37.7",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.4.23",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "nodemon": "^3.1.11",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18"
  }
}
